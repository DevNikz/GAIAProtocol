            "m_Id": "aba279b372d74786a1cc33b1105d7c17"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ReconstructWorldPos_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float deviceDepth = SampleCameraDepth(UV); // handles dynamic res internally\n    WorldPos = ComputeWorldSpacePosition(UV, deviceDepth, UNITY_MATRIX_I_VP);"
}

{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "bd94739c00624c7d8e6dc54a51bcdd32",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RadarRing_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -199.99996948242188,
            "y": 794.9999389648438,
            "width": 259.0000305175781,
            "height": 214.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c60b10ecaf8b486d8f9ea0056c46f246"
        },
        {
            "m_Id": "c84bbc3f493e4b1ba6fdfe82d4ccf0cf"
        },
        {
            "m_Id": "6ce4af4dd6134e8d8f8ee6cbf414c8c2"
        },
        {
            "m_Id": "fda9105096db420e92003ae2432fc731"
        },
        {
            "m_Id": "0b090bd2796b45309e1f6d953680bd07"
        },
        {
            "m_Id": "926c13bc79194156bd14af76e014eace"
        },
        {
            "m_Id": "07761725ff3f42afb2b5480c2edd3aac"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RadarRing_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 originRelative = Origin - _WorldSpaceCameraPos; // convert absolute -> camera-relative\n    float dist = distance(WorldPos, originRelative);\n    float ring = 1 - saturate(abs(dist - Radius) / Width);\n    ring = pow(ring, 2);\n    float overallFade = saturate(1 - (Radius / MaxRadius)) * Fade;\n    Alpha = ring * overallFade;"
}

